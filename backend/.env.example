PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/football-auth
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_ORIGIN=http://localhost:5173
FORMATION_TOLERANCE=30
USE_FILE_DB=false
# Optional local workaround if your ISP cannot resolve Atlas SRV records.
# Leave blank on Heroku unless its DNS resolution also fails.
MONGO_DNS_SERVERS=
# Heroku sets NODE_ENV=production and PORT itself. Do not set PORT on Heroku.
