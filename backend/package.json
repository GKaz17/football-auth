{
  "name": "football-auth-backend",
  "version": "1.0.0",
  "description": "Express API for football formation visual-password authentication.",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon --exec \"node --use-system-ca\" server.js",
    "start": "node --use-system-ca server.js",
    "check:db": "node --use-system-ca scripts/checkDatabase.js",
    "test:atlas": "node --use-system-ca scripts/smokeTestAtlas.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "mongodb-memory-server-core": "^10.4.3",
    "nodemon": "^3.1.9"
  }
}
